{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "racing/index.html", "use": "@vercel/static" },
    { "src": "survival/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/racing", "dest": "/racing/index.html" },
    { "src": "/racing/", "dest": "/racing/index.html" },
    { "src": "/survival", "dest": "/survival/index.html" },
    { "src": "/survival/", "dest": "/survival/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
